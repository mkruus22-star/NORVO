{
  // Cloudflare Worker "norvo": serveerib kodulehe faile ja /api/pakkumine funktsiooni
  "name": "norvo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": true}
}
